#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)

#include <stdio.h>

void get_data(int* array, int n);

int main(void)
{
    int i;
    int data[5]; // 배열 크기 [5]를 명확하게 지정
    
    get_data(data, 5);
    
    for (i = 0; i < 5; i++)
    {
        printf("%d번째 data:%d\n", i + 1, data[i]);
    }
    return 0;
}

void get_data(int* array, int n)
{
    for (int i = 0; i < n; i++)
    {
        printf("%d번째 data를 입력하시오: ", i + 1);
        scanf("%d", &array[i]);
    }
}
