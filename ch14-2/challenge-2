#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)

#include <stdio.h>

int main(void)
{
    int num, i = 0;
    int binary[32]; // 정수 비트를 모두 담을 수 있도록 안정적인 크기 분배

    printf("10진수 정수 입력: ");
    scanf("%d", &num);

    if (num == 0) { printf("0\n"); return 0; }

    while (num > 0)
    {
        binary[i++] = num % 2;
        num /= 2;
    }
    for (int j = i - 1; j >= 0; j--)
    {
        printf("%d", binary[j]);
    }
    printf("\n");
    return 0;
}
