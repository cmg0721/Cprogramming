#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)

#include <stdio.h>

void ShowAllData(const int* arr, int len)
{
    int i;
    for (i = 0; i < len; i++)
    {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main(void)
{
    int arr[5] = { 1, 2, 3, 4, 5 }; // 대괄호 선언 추가로 구문 오류 해결
    ShowAllData(arr, 5);
    return 0;
}
