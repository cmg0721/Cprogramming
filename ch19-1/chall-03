#define _CRT_SECURE_NO_WARNINGS // 보안오류방지
#pragma warning(disable:6031)   // 리턴값관련 경고 방지
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    printf("난수의 범위: 0부터 99까지\n");

    for (int i = 0; i < 5; i++) {
        printf("난수 출력: %d\n", rand() % 100);
    }

    return 0;
}
