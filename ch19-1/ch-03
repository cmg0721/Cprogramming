#define _CRT_SECURE_NO_WARNINGS // 보안오류방지
#pragma warning(disable:6031)   // 리턴값관련 경고 방지
#include <stdio.h>

int add(int a, int b) { return a + b; }
int sub(int a, int b) { return a - b; }
int mul(int a, int b) { return a * b; }
int dvd(int a, int b) { if (b != 0) return a / b; return 0; }

void calculate(int (*calcFunc)(int, int)) {
    int num1, num2;
    printf("두개의 정수를 입력하시오 : ");
    scanf("%d %d", &num1, &num2);
    printf("결과값: %d\n", calcFunc(num1, num2));
}

int main(void) {
    int menu;
    printf("연산을 선택하시오(1:덧셈,2:뺄셈,3:곱셈,4:나눗셈) : ");
    scanf("%d", &menu);

    if (menu == 1) calculate(add);
    else if (menu == 2) calculate(sub);
    else if (menu == 3) calculate(mul);
    else if (menu == 4) calculate(dvd);
    else printf("잘못된 선택입니다.\n");

    return 0;
}
