#define _CRT_SECURE_NO_WARNINGS // 보안오류방지
#pragma warning(disable:6031)   // 리턴값관련 경고 방지
#include <stdio.h>

void printResult(int a, int b, int (*op)(int, int)) {
    printf("연산 결과: %d\n", op(a, b));
}

int add(int a, int b) { return a + b; }

int main(void) {
    printResult(10, 20, add);
    return 0;
}
