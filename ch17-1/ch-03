#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)

#include <stdio.h>

void prn_str(char** arr, int size);

int main(void)
{
    char* ptrarr[] = {"eagle", "tiger", "lion", "squirrel" };
    int count;
    
    count = sizeof(ptrarr)/sizeof(ptrarr[0]);
    prn_str(ptrarr, count);
    
    return 0;
}

void prn_str(char** arr, int size)
{
    for (int i = 0; i < size; i++) {
        printf("%s\n", arr[i]);
    }
}
